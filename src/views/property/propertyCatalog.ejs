<!DOCTYPE html>
<html lang="ru">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Каталог недвижимости — Roommy</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
    </style>
</head>

<body class="bg-white text-gray-900 antialiased min-h-screen flex flex-col">

    <header class="border-b border-gray-100 bg-white sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <a href="/" class="text-2xl font-bold tracking-tight text-blue-600">Roommy</a>
            </div>

            <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-gray-600">
                <a href="/" class="hover:text-gray-900 transition">Главная</a>
                <a href="/catalog" class="text-blue-600 font-semibold">Каталог</a>
            </nav>

            <div class="flex items-center gap-4">
                <a href="/property/addProperty"
                    class="bg-blue-600 hover:bg-blue-700 text-white font-medium text-xs px-4 py-2.5 rounded-xl transition shadow-sm">
                    Разместить обьявление
                </a>
            </div>
        </div>
    </header>

    <main class="max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-grow">

        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
            <div>
                <h1 class="text-2xl font-bold tracking-tight text-gray-950">Аренда недвижимости</h1>
                <p class="text-sm text-gray-500 mt-1">
                    <% if (typeof rooms !=='undefined' ) { %>
                        Найдено вариантов: <%= rooms.length %>
                            <% } else { %>
                                Найдено вариантов: 3
                                <% } %>
                </p>
            </div>

            <div class="flex items-center gap-2 self-end sm:self-auto">
                <label for="sort"
                    class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Сортировка:</label>
                <select id="sort"
                    class="bg-gray-50 border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:border-blue-500 transition">
                    <option>Сначала новые</option>
                    <option>Подешевле</option>
                    <option>Подороже</option>
                </select>
            </div>
        </div>

        <!-- <div class="grid grid-cols-1 lg:grid-cols-4 gap-8 items-start">

            <aside class="lg:col-span-1 bg-white p-6 rounded-2xl border border-gray-100 shadow-sm sticky top-24">
                <form action="/catalog" method="GET" class="space-y-6">
                    <div class="border-b border-gray-50 pb-2">
                        <h2 class="text-sm font-bold text-gray-950 uppercase tracking-wider">Фильтры</h2>
                    </div>


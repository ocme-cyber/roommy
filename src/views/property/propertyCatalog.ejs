                            <input type="number" name="priceFrom" placeholder="От"
                                class="w-full bg-gray-50 border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:border-blue-500 transition">
                            <span class="text-gray-300">—</span>
                            <input type="number" name="priceTo" placeholder="До"
                                class="w-full bg-gray-50 border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:border-blue-500 transition">
                        </div>
                    </div>

                    <button type="submit"
                        class="w-full bg-gray-950 hover:bg-gray-800 text-white font-medium text-sm py-2.5 rounded-xl transition shadow-sm">
                        Применить фильтры
                    </button>
                </form>
            </aside> -->

            <section class="lg:col-span-3">
                <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6">
            
            <% if (typeof rooms !=='undefined' && rooms.length> 0) { %>
                <% rooms.forEach(room=> { %>
                    <div
                        class="group bg-white border border-gray-100 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition flex flex-col justify-between">
                        <div>
                            <div
                                class="aspect-video w-full bg-gray-50 relative border-b border-gray-100 flex items-center justify-center text-gray-400 text-xs overflow-hidden">
                                <% if (room.images && room.images.length> 0) { %>
                                    <img src="<%= room.images[0] %>" alt="<%= room.title %>"
                                        class="w-full h-full object-cover group-hover:scale-105 transition duration-300">
                                    <% } else { %>
                                        <span>Фотографии объекта</span>
                                    <% } %>
    
                                <div class="absolute top-3 left-3 flex gap-1 flex-wrap z-10">
                                    <% if (room.isLongTerm) { %>
                                        <span
                                            class="bg-blue-50/90 backdrop-blur-xs text-blue-700 text-[10px] font-bold px-2.5 py-0.5 rounded-full border border-blue-100">Долгосрочно</span>
                                        <% } %>
                                            <% if (room.isShortTerm) { %>
                                                <span
                                                    class="bg-purple-50/90 backdrop-blur-xs text-purple-700 text-[10px] font-bold px-2.5 py-0.5 rounded-full border border-purple-100">Посуточно</span>
                                        <% } %>
                                </div>
                            </div>

                    <div class="p-4 space-y-1">
                        <h3 class="font-bold text-gray-900 text-sm group-hover:text-blue-600 transition truncate">
                            <%= room.title %>
                        </h3>
                        <p class="text-xs text-gray-400 truncate">
                            <%= room.location %>
                        </p>
                        <% if (room.description) { %>
                            <p class="text-xs text-gray-500 line-clamp-2 pt-1">
                                <%= room.description %>
                            </p>
                            <% } %>
                    </div>
                </div>

                <div class="p-4 pt-0 border-t border-gray-50 mt-3 flex items-center justify-between">
                    <span class="font-extrabold text-gray-950 text-base">
                        <%= room.price.toLocaleString('ru-RU') %> ₽<span class="text-xs font-normal text-gray-400">/
                                <%= room.isShortTerm && !room.isLongTerm ? 'сут' : 'мес' %></span>
                    </span>
                    <a href="/property/<%= room.id %>"
                        class="text-xs font-semibold text-blue-600 hover:text-blue-700 transition">
                        Подробнее &rarr;
                    </a>
                </div>
            </div>
            <% }) %>
                <% } else { %>
                    <div
                        class="group bg-white border border-gray-100 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition flex flex-col justify-between">
                        <div>
                            <div
                                class="aspect-video w-full bg-gray-50 relative border-b border-gray-100 flex items-center justify-center text-gray-400 text-xs">
                                Фотографии объекта
                                <div class="absolute top-3 left-3 flex gap-1">
                                    <span
                                        class="bg-blue-50 text-blue-700 text-[10px] font-bold px-2.5 py-0.5 rounded-full border border-blue-100">Долгосрочно</span>
                                </div>
                            </div>
                            <div class="p-4 space-y-1">
                                <h3 class="font-bold text-gray-900 text-sm group-hover:text-blue-600 transition">
                                    1-комнатная квартира, 42 м²</h3>
                                <p class="text-xs text-gray-400">м. Аэропорт, 10 мин. пешком</p>
                                <p class="text-xs text-gray-500 line-clamp-2 pt-1">Светлая уютная квартира с
                                    дизайнерским ремонтом. Есть вся необходимая техника...</p>
                            </div>
                        </div>
                        <div class="p-4 pt-0 border-t border-gray-50 mt-3 flex items-center justify-between">
                            <span class="font-extrabold text-gray-950 text-base">80 000 ₽<span
                                    class="text-xs font-normal text-gray-400">/мес</span></span>
                            <span class="text-xs font-semibold text-blue-600">Подробнее &rarr;</span>
                        </div>
                    </div>

                    <div
                        class="group bg-white border border-gray-100 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition flex flex-col justify-between">
                        <div>
                            <div
                                class="aspect-video w-full bg-gray-50 relative border-b border-gray-100 flex items-center justify-center text-gray-400 text-xs">
                                Фотографии объекта
                                <div class="absolute top-3 left-3 flex gap-1">
                                    <span
                                        class="bg-purple-50 text-purple-700 text-[10px] font-bold px-2.5 py-0.5 rounded-full border border-purple-100">Посуточно</span>
                                </div>
                            </div>
                            <div class="p-4 space-y-1">
                                <h3 class="font-bold text-gray-900 text-sm group-hover:text-blue-600 transition">
                                    Уютная студия в центре</h3>
                                <p class="text-xs text-gray-400">м. Чистые пруды, 5 мин. пешком</p>
                                <p class="text-xs text-gray-500 line-clamp-2 pt-1">Отличный вариант для туристов и
                                    бизнес-поездок. Идеально чистая, бесконтактное заселение.</p>
                            </div>
                        </div>
                        <div class="p-4 pt-0 border-t border-gray-50 mt-3 flex items-center justify-between">
                            <span class="font-extrabold text-gray-950 text-base">4 500 ₽<span
                                    class="text-xs font-normal text-gray-400">/сут</span></span>
                            <span class="text-xs font-semibold text-blue-600">Подробнее &rarr;</span>
                        </div>
                    </div>

                    <div
                        class="group bg-white border border-gray-100 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition flex flex-col justify-between">
                        <div>
                            <div
                                class="aspect-video w-full bg-gray-50 relative border-b border-gray-100 flex items-center justify-center text-gray-400 text-xs">
                                Фотографии объекта
                                <div class="absolute top-3 left-3 flex gap-1">
                                    <span
                                        class="bg-blue-50 text-blue-700 text-[10px] font-bold px-2.5 py-0.5 rounded-full border border-blue-100">Долгосрочно</span>
                                </div>
                            </div>
                            <div class="p-4 space-y-1">
                                <h3 class="font-bold text-gray-900 text-sm group-hover:text-blue-600 transition">
                                    Современная евро-двушка</h3>
                                <p class="text-xs text-gray-400">м. Раменки, 15 мин. пешком</p>
                                <p class="text-xs text-gray-500 line-clamp-2 pt-1">Новый дом, охраняемая территория.
                                    Квартира сдается впервые на длительный срок.</p>
                            </div>
                        </div>
                        <div class="p-4 pt-0 border-t border-gray-50 mt-3 flex items-center justify-between">
                            <span class="font-extrabold text-gray-950 text-base">95 000 ₽<span
                                    class="text-xs font-normal text-gray-400">/мес</span></span>
                            <span class="text-xs font-semibold text-blue-600">Подробнее &rarr;</span>
                        </div>
                    </div>
                    <% } %>
            
                </div>
            </section>

        </div>
    </main>

    <footer class="border-t border-gray-100 bg-white py-8 mt-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-xs text-gray-400">
            &copy; 2026 Roommy. Все права защищены.
        </div>
    </footer>

</body>

</html>
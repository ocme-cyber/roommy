                                    class="w-4 h-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500/30 accent-blue-600">
                                <span>Долгосрочная</span>
                            </label>
                            <label class="flex items-center gap-2.5 cursor-pointer select-none">
                                <input type="checkbox" name="shortTerm" value="true"
                                    class="w-4 h-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500/30 accent-blue-600">
                                <span>Посуточная</span>
                            </label>

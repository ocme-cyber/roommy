                    </div>

                    <div class="space-y-2">
                        <label class="text-xs font-semibold text-gray-400 uppercase tracking-wider block">Тип
                            жилья</label>
                        <div class="space-y-2 text-sm text-gray-700">
                            <label class="flex items-center gap-2.5 cursor-pointer select-none">
                                <input type="checkbox" name="type" value="studio"
                                    class="w-4 h-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500/30 accent-blue-600">
                                <span>Студия</span>
                            </label>
                            <label class="flex items-center gap-2.5 cursor-pointer select-none">
                                <input type="checkbox" name="type" value="1k"
                                    class="w-4 h-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500/30 accent-blue-600">
                                <span>1-комнатная</span>
                            </label>
                            <label class="flex items-center gap-2.5 cursor-pointer select-none">
                                <input type="checkbox" name="type" value="2k"
                                    class="w-4 h-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500/30 accent-blue-600">
                                <span>2-комнатная</span>
                            </label>
                            <label class="flex items-center gap-2.5 cursor-pointer select-none">

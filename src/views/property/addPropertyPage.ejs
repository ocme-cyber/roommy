<!DOCTYPE html>
<html lang="ru">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Разместить объявление — Roommy</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
    </style>
</head>

<body class="bg-gray-50 text-gray-900 antialiased min-h-screen flex flex-col justify-between">

    <header class="border-b border-gray-100 bg-white sticky top-0 z-50">
        <div class="max-w-3xl mx-auto px-4 h-16 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <a href="/" class="text-2xl font-bold tracking-tight text-blue-600">Roommy</a>
            </div>
            <div class="flex items-center gap-4">
                <button onclick="history.back();"
                    class="text-sm font-medium text-gray-600 hover:text-gray-900 transition cursor-pointer">Отмена</button>
            </div>
        </div>
    </header>

    <main class="flex-grow flex items-center justify-center px-4 py-12">
        <div
            class="bg-white p-8 sm:p-10 rounded-2xl shadow-xl shadow-gray-100/70 border border-gray-100 max-w-2xl w-full">

            <div class="mb-8">
                <h1 class="text-2xl font-bold tracking-tight text-gray-950">Новое объявление</h1>
                <p class="text-sm text-gray-500 mt-1">Заполните информацию о вашей квартире, чтобы начать получать
                    предложения от арендаторов.</p>
            </div>

            <form id="propertyForm" class="space-y-6" onsubmit="addProperty(event)">

                <div class="space-y-1.5">
                    <label for="title" class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Название
                        объявления</label>
                    <input type="text" id="title" name="title" required
                        placeholder="Например: 1-комнатная квартира, 42 м²"
                        class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-blue-500 transition">
                </div>

                <div class="space-y-1.5">
                    <label for="location" class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Адрес или
                        Метро</label>
                    <input type="text" id="location" name="location" required
                        placeholder="Например: м. Аэропорт, 10 мин. пешком"
                        class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-blue-500 transition">
                </div>
                <div class="space-y-1.5">
                    <label for="phoneNumber" class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Номер телефона</label>
                    <input type="text" id="phoneNumber" name="phoneNumber" required placeholder="Например: 7 987 028 18 65"
                        class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-blue-500 transition">
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="space-y-1.5">
                        <label for="type" class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Тип
                            недвижимости</label>
                        <select id="type" name="type"
                            class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-blue-500 transition">
                            <option value="studio">Студия</option>
                            <option value="1k">1-комнатная кв.</option>
                            <option value="2k">2-комнатная кв.</option>
                            <option value="room">Комната</option>
                        </select>
                    </div>

                    <div class="space-y-1.5">
                        <label for="price" class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Цена
                            аренды (₽ / мес)</label>
                        <input type="number" id="price" name="price" required placeholder="65 000" min="500"
                            class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-blue-500 transition">
                    </div>
                </div>

                <div class="space-y-2">
                    <label class="text-xs font-semibold text-gray-400 uppercase tracking-wider block">Варианты
                        аренды</label>
                    <div
                        class="flex flex-col sm:flex-row gap-4 bg-gray-50 p-4 rounded-xl border border-gray-200/60 text-sm">
                        <label class="flex items-center gap-3 cursor-pointer select-none py-1 sm:py-0 flex-1">
                            <input type="checkbox" name="isLongTerm" value="true" checked id="isLongTerm"
                                class="w-4 h-4 rounded-md border-gray-300 text-blue-600 focus:ring-blue-500/30 accent-blue-600">
                            <div>
                                <span class="font-medium text-gray-900 block">Долгосрочная аренда</span>
                                <span class="text-xs text-gray-400">Сдача на месяц и более</span>
                            </div>
                        </label>

                        <div class="hidden sm:block border-l border-gray-200 my-1 mx-2"></div>

                        <label class="flex items-center gap-3 cursor-pointer select-none py-1 sm:py-0 flex-1">
                            <input type="checkbox" name="isShortTerm" value="true" id="isShortTerm"
                                class="w-4 h-4 rounded-md border-gray-300 text-blue-600 focus:ring-blue-500/30 accent-blue-600">
                            <div>
                                <span class="font-medium text-gray-900 block">Посуточная аренда</span>
                                <span class="text-xs text-gray-400">Посуточное проживание</span>
                            </div>
                        </label>
                    </div>
                </div>

                <div class="space-y-1.5">
                    <label for="description"
                        class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Описание квартиры</label>
                    <textarea id="description" name="description" rows="4"
                        placeholder="Расскажите про ремонт, технику, инфраструктуру рядом и ваши пожелания к жильцам..."
                        class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-blue-500 transition resize-none"></textarea>
                </div>

                <div class="space-y-1.5">
                    <label class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Фотографии</label>
                    <div onclick="document.getElementById('images').click()"
                        class="border-2 border-dashed border-gray-200 rounded-xl p-6 text-center bg-gray-50 hover:bg-gray-100/50 transition cursor-pointer relative">

                        <input type="file" id="images" name="images" multiple accept="image/*" class="hidden"
                            onchange="updateFileCounter(this)">

                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                            stroke="currentColor" class="w-8 h-8 text-gray-400 mx-auto mb-2">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                d="M6.827 6.175A2.31 2.31 0 0 1 5.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 0 0-1.134-.175 2.31 2.31 0 0 1-1.64-1.055l-.822-1.316a2.192 2.192 0 0 0-1.736-1.039 48.774 48.774 0 0 0-5.232 0 2.192 2.192 0 0 0-1.736 1.039l-.821 1.316Z" />
                            <path stroke-linecap="round" stroke-linejoin="round"
                                d="M16.5 12.75a4.5 4.5 0 1 1-9 0 4.5 4.5 0 0 1 9 0ZM18.75 10.5h.008v.008h-.008V10.5Z" />
                        </svg>
                        <span id="uploadText" class="text-xs font-medium text-blue-600 block">Загрузить
                            фотографии</span>
                        <span class="text-[10px] text-gray-400 mt-1 block">До 10 файлов, формат JPG или PNG</span>
                    </div>
                </div>

                <div class="pt-4 flex gap-4">
                    <button type="submit"
                        class="flex-grow bg-blue-600 hover:bg-blue-700 text-white font-medium text-sm py-3 rounded-xl transition shadow-md shadow-blue-100 text-center cursor-pointer">
                        Опубликовать объявление
                    </button>
                </div>
            </form>

        </div>
    </main>

    <footer class="p-6 text-center text-xs text-gray-400">
        &copy; 2026 Roommy. Все права защищены.
    </footer>

</body>
<script>
    function updateFileCounter(input) {
        const textSpan = document.getElementById('uploadText');
        if (input.files && input.files.length > 0) {
            textSpan.textContent = `Выбрано файлов: ${input.files.length}`;
            textSpan.className = "text-xs font-semibold text-green-600 block";
        } else {
            textSpan.textContent = "Загрузить фотографии";
            textSpan.className = "text-xs font-medium text-blue-600 block";
        }
    }
    async function addProperty(e) {
        e.preventDefault()
        const formElement = document.getElementById('propertyForm')
        const formData = new FormData(formElement)

        try {
            const response = await fetch("/property/add/", {
                method: "POST",
                body: formData
            });

            if (response.ok) {
                window.location.href = '/property/catalog'
            } else {
                const errData = await response.json();
                alert(`Ошибка при публикации: ${errData.message || 'Что-то пошло не так'}`);
            }
        } catch (error) {
            console.error('Ошибка сети:', error);
            alert('Не удалось связаться с сервером.');
        }
    }
</script>

</html>
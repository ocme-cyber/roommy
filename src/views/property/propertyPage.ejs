<!DOCTYPE html>
<html lang="ru">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= room.title %> — Roommy
    </title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }

        /* Прячем дефолтный скроллбар в слайдере, сохраняя плавный скролл */
        .scrollbar-none::-webkit-scrollbar {
            display: none;
        }

        .scrollbar-none {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</head>

<body class="bg-gray-50 text-gray-900 antialiased min-h-screen flex flex-col">

    <header class="border-b border-gray-100 bg-white sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <a href="/" class="text-2xl font-bold tracking-tight text-blue-600">Roommy</a>
            </div>
            <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-gray-600">
                <a href="/" class="hover:text-gray-900 transition">Главная</a>
                <a href="/property/catalog" class="text-blue-600 font-semibold">Каталог</a>
            </nav>
            <div class="flex items-center gap-4">
                <a href="/property/addProperty"
                    class="bg-blue-600 hover:bg-blue-700 text-white font-medium text-xs px-4 py-2.5 rounded-xl transition shadow-sm">
                    Разместить обьявление
                </a>
            </div>
        </div>
    </header>

    <main class="max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 flex-grow">

        <div class="mb-6">
            <a href="/catalog"
                class="inline-flex items-center gap-2 text-sm font-semibold text-gray-500 hover:text-gray-900 transition">
                &larr; Назад к каталогу
            </a>
        </div>

        <div class="mb-6">
            <div class="flex flex-wrap items-center gap-2 mb-2">
                <% if (room.isLongTerm) { %>
                    <span
                        class="bg-blue-50 text-blue-700 text-xs font-bold px-3 py-1 rounded-full border border-blue-100">Долгосрочно</span>
                    <% } %>
                        <% if (room.isShortTerm) { %>
                            <span
                                class="bg-purple-50 text-purple-700 text-xs font-bold px-3 py-1 rounded-full border border-purple-100">Посуточно</span>
                            <% } %>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-gray-950">
                <%= room.title %>
            </h1>
            <p class="text-sm text-gray-500 mt-1.5 flex items-center gap-1">
                <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <%= room.location %>
            </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">

            <div class="lg:col-span-2 space-y-6">

                <div class="bg-white border border-gray-100 rounded-2xl overflow-hidden shadow-sm">
                    <div class="relative group/gallery">
                        <% if (room.images && room.images.length> 0) { %>

                            <div id="gallerySlider"
                                class="aspect-[16/9] w-full bg-gray-100 flex overflow-x-auto scroll-smooth snap-x snap-mandatory scrollbar-none">
                                <% room.images.forEach((img, index)=> { %>
                                    <div id="slide-<%= index %>" class="w-full h-full flex-shrink-0 snap-start">
                                        <img src="<%= img %>" alt="<%= room.title %> — Фото <%= index + 1 %>"
                                            class="w-full h-full object-cover">
                                    </div>
                                    <% }) %>
                            </div>

                            <% if (room.images.length> 1) { %>
                                <button onclick="scrollGallery(-1)"
                                    class="absolute left-4 top-1/2 -translate-y-1/2 bg-white/80 backdrop-blur-md hover:bg-white text-gray-800 p-2 rounded-full shadow-md transition opacity-0 group-hover/gallery:opacity-100 cursor-pointer hidden sm:block">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M15 19l-7-7 7-7" />
                                    </svg>
                                </button>
                                <button onclick="scrollGallery(1)"
                                    class="absolute right-4 top-1/2 -translate-y-1/2 bg-white/80 backdrop-blur-md hover:bg-white text-gray-800 p-2 rounded-full shadow-md transition opacity-0 group-hover/gallery:opacity-100 cursor-pointer hidden sm:block">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M9 5l7 7-7 7" />
                                    </svg>
                                </button>

                                <div
                                    class="absolute bottom-4 right-4 bg-black/60 backdrop-blur-xs text-white text-xs px-2.5 py-1 rounded-md font-medium sm:hidden">
                                    <span id="currentSlideIdx">1</span> / <%= room.images.length %>
                                </div>
                                <% } %>

                                    <% } else { %>
                                        <div
                                            class="aspect-[16/9] w-full bg-gray-100 flex items-center justify-center text-gray-400 text-sm">
                                            <div class="text-center">
                                                <svg class="w-12 h-12 mx-auto text-gray-300 mb-2" fill="none"
                                                    stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                        stroke-width="2"
                                                        d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 002-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                                </svg>
                                                <span>Фотографии отсутствуют</span>
                                            </div>
                                        </div>
                                        <% } %>
                    </div>

                    <% if (room.images && room.images.length> 1) { %>
                        <div class="p-4 border-t border-gray-50 flex gap-2 overflow-x-auto">
                            <% room.images.forEach((img, index)=> { %>
                                <button onclick="scrollToSlide()"
                                    class="w-20 h-14 rounded-lg overflow-hidden bg-gray-100 flex-shrink-0 border-2 border-transparent focus:border-blue-600 hover:opacity-90 transition outline-none cursor-pointer">
                                    <img src="<%= img %>" alt="Превью <%= index + 1 %>"
                                        class="w-full h-full object-cover">
                                </button>
                                <% }) %>
                        </div>
                        <% } %>
                </div>

                <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm">
                    <h2 class="text-lg font-bold text-gray-950 mb-4">О жилье</h2>
                    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 text-sm">
                        <div class="bg-gray-50 p-3 rounded-xl">
                            <span class="block text-xs font-semibold text-gray-400 uppercase tracking-wider">Тип
                                жилья</span>
                            <span class="font-bold text-gray-900 mt-0.5 block">
                                <% if (room.type==='studio' ) { %> Студия
                                    <% } else if (room.type==='1k' ) { %> 1-комнатная
                                        <% } else if (room.type==='2k' ) { %> 2-комнатная
                                            <% } else if (room.type==='room' ) { %> Комната
                                                <% } else { %> Квартира <% } %>
                            </span>
                        </div>
                        <div class="bg-gray-50 p-3 rounded-xl">
                            <span
                                class="block text-xs font-semibold text-gray-400 uppercase tracking-wider">Залог</span>
                            <span class="font-bold text-gray-900 mt-0.5 block">
                                <%= typeof room.deposit !=='undefined' ? room.deposit.toLocaleString('ru-RU') + ' ₽'
                                    : 'Нет' %>
                            </span>
                        </div>
                        <div class="bg-gray-50 p-3 rounded-xl col-span-2 sm:col-span-1">
                            <span
                                class="block text-xs font-semibold text-gray-400 uppercase tracking-wider">Доступность</span>
                            <span class="font-bold text-gray-900 mt-0.5 block">Свободна</span>
                        </div>
                    </div>
                </div>

                <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm">
                    <h2 class="text-lg font-bold text-gray-950 mb-3">Описание от собственника</h2>
                    <div class="text-sm text-gray-600 leading-relaxed whitespace-pre-line">
                        <% if (room.description) { %>
                            <%= room.description %>
                                <% } else { %>
                                    <p class="text-gray-400 italic">Описание не указано.</p>
                                    <% } %>
                    </div>
                </div>

            </div>

            <aside class="lg:col-span-1 space-y-6 lg:sticky top-24">
                <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm">

                    <div class="mb-4">
                        <span class="text-3xl font-black text-gray-950">
                            <%= room.price.toLocaleString('ru-RU') %> ₽
                        </span>
                        <span class="text-sm text-gray-400">
                            /<%= room.isShortTerm && !room.isLongTerm ? 'сутки' : 'месяц' %>
                        </span>
                    </div>

                    <div class="border-t border-gray-50 pt-4 space-y-3">
                        <div class="flex justify-between text-xs text-gray-500">
                            <span>Коммунальные платежи</span>
                            <span class="font-medium text-gray-900">Включены</span>
                        </div>
                        <div class="flex justify-between text-xs text-gray-500">
                            <span>Комиссия Roommy</span>
                            <span class="font-medium text-green-600">0% (Без комиссии)</span>
                        </div>
                    </div>

                    <div class="mt-6 space-y-2.5">
                        <button onclick="this.innerHTML = 'Позвонить: <%= room.phoneNumber %>'"
                            class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm py-3 rounded-xl transition shadow-xs flex items-center justify-center gap-2 cursor-pointer">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M3 5a2 2 0 012-2h3.28a1 1 0 01.94.725l.548 2.2a1 1 0 01-.321.988l-1.305.98a10.582 10.582 0 004.872 4.872l.98-1.305a1 1 0 01.988-.321l2.2.548a1 1 0 01.725.94V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                            </svg>
                            Показать телефон
                        </button>
                    </div>

                    <p class="text-[10px] text-gray-400 text-center mt-4 leading-normal">
                        Никогда не переводите предоплату до личного осмотра объекта и подписания договора аренды.
                    </p>
                </div>
            </aside>

        </div>
    </main>

    <footer class="border-t border-gray-100 bg-white py-8 mt-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-xs text-gray-400">
            &copy; 2026 Roommy. Все права защищены.
        </div>
    </footer>

    <script>
        const slider = document.getElementById('gallerySlider');
        const indicator = document.getElementById('currentSlideIdx');

        // Перемотка на нужный слайд по клику на превью
        function scrollToSlide(index) {
            const slide = document.getElementById(`slide-${index}`);
            if (slider && slide) {
                slider.scrollTo({
                    left: slide.offsetLeft,
                    behavior: 'smooth'
                });
            }
        }

        // Кнопки-стрелки (Влево / Вправо)
        function scrollGallery(direction) {
            if (!slider) return;
            const slideWidth = slider.clientWidth;
            slider.scrollBy({
                left: direction * slideWidth,
                behavior: 'smooth'
            });
        }

        // Обновление цифр мобильного счетчика (например, 2 / 5) при скролле пальцем
        if (slider && indicator) {
            slider.addEventListener('scroll', () => {
                const index = Math.round(slider.scrollLeft / slider.clientWidth);
                indicator.innerText = index + 1;
            });
        }
    </script>
</body>

</html>
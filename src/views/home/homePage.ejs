<!DOCTYPE html>
<html lang="ru">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Roommy — Простая аренда недвижимости</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
    </style>
</head>

<body class="bg-gray-50/50 text-gray-900 antialiased min-h-screen flex flex-col">

    <header class="border-b border-gray-100 bg-white/80 backdrop-blur-md sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <a href="/" class="text-2xl font-black tracking-tight text-blue-600">Roommy</a>
            </div>

            <nav class="hidden md:flex items-center gap-8 text-sm font-semibold text-gray-600">
                <a href="/" class="text-blue-600">Главная</a>
                <a href="/property/catalog" class="hover:text-gray-900 transition">Каталог</a>
            </nav>

            <div class="flex items-center gap-4">
                <% if (user) { %>
                    <a href="/user/profile"
                        class="text-sm font-semibold text-gray-700 hover:text-gray-900 flex items-center gap-2 bg-gray-50 px-3 py-2 rounded-xl border border-gray-100">
                        <div
                            class="w-6 h-6 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center text-xs font-bold uppercase">
                            <%= user.username.substring(0, 2) %>
                        </div>
                        <%= user.username %>
                    </a>
                    <a href="/property/addProperty"
                        class="text-xs font-bold bg-blue-600 text-white px-4 py-2.5 rounded-xl hover:bg-blue-700 transition shadow-sm">Разместить
                        объявление</a>
                    <% } else { %>
                        <a href="/user/login"
                            class="text-sm font-semibold text-gray-700 hover:text-gray-900 px-3 py-2">Войти</a>
                        <% } %>
            </div>
        </div>
    </header>

    <section class="relative bg-gradient-to-b from-blue-50/50 to-transparent pt-20 pb-16 lg:pt-28 lg:pb-20">
        <div class="max-w-4xl mx-auto text-center px-4">
            <h1 class="text-4xl sm:text-6xl font-black tracking-tight text-gray-950 mb-6 leading-[1.1]">
                Снять. Сдать. <br class="sm:hidden"> <span class="text-blue-600">Без лишних забот.</span>
            </h1>
            <p class="text-base sm:text-lg text-gray-500 max-w-xl mx-auto mb-10 font-medium">
                Найдите свой уютный угол в один клик. Прямая аренда от проверенных собственников без скрытых комиссий.
            </p>

            <form action="/property/catalog" method="GET"
                class="max-w-2xl mx-auto bg-white p-2 rounded-2xl border border-gray-100 shadow-xl shadow-gray-200/50 flex flex-col sm:flex-row gap-2 items-stretch">
                <div class="flex-grow flex items-center px-3 gap-2 text-gray-400">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                    <input type="text" name="search" placeholder="Город, район или улица..."
                        class="w-full bg-transparent border-none text-sm text-gray-900 placeholder-gray-400 focus:outline-none py-2">
                </div>
                <button type="submit"
                    class="bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm px-6 py-3 rounded-xl transition cursor-pointer shadow-xs">
                    Найти жилье
                </button>
            </form>
        </div>
    </section>

    <main class="max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-10 flex-grow">
        <div class="flex items-center justify-between mb-8">
            <div>
                <h2 class="text-xl sm:text-2xl font-extrabold text-gray-950 tracking-tight">Популярно прямо сейчас</h2>
                <p class="text-xs text-gray-400 mt-0.5 font-medium">Лучшие варианты, подобранные пользователями</p>
            </div>
            <a href="/property/catalog"
                class="text-xs font-bold text-blue-600 hover:text-blue-700 transition flex items-center gap-1">
                Смотреть все
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                </svg>
            </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            <% rooms.forEach(room => { %>
                <a href="/property/<%= room.id %>">
                    <div
                        class="bg-white rounded-2xl border border-gray-100 overflow-hidden shadow-xs hover:shadow-md transition duration-300 group">
                        <div class="aspect-[16/10] w-full bg-gray-100 relative overflow-hidden">
                            <img src="<%= room.images[0] %>" alt="Интерьер" class="w-full h-full object-cover group-hover:scale-103 transition duration-500">
                        </div>
                        <div class="p-5">
                            <div class="text-lg font-black text-gray-950 mb-1"><%= room.price %> <span class="text-xs font-medium text-gray-400">/
                                    мес</span></div>
                            <h3 class="font-bold text-sm text-gray-900 group-hover:text-blue-600 transition line-clamp-1">
                                <%= room.title%></h3>
                            <p class="text-xs text-gray-400 mt-1.5 flex items-center gap-1">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                                </svg>
                                <%= room.location %>
                            </p>
                        </div>
                    </div>
                </a>
          <%  }); %>
            

        </div>
    </main>

    <footer class="border-t border-gray-100 bg-white py-12 mt-auto">
        <div
            class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-gray-400 font-medium">
            <div>
                &copy; 2026 Roommy. Все права защищены.
            </div>
            <div class="flex gap-6">
                <a href="#" class="hover:text-gray-900 transition">Конфиденциальность</a>
                <a href="#" class="hover:text-gray-900 transition">Условия использования</a>
                <a href="#" class="hover:text-gray-900 transition">Поддержка</a>
            </div>
        </div>
    </footer>

</body>

</html>